{
   "compilerOptions": {
      "lib": [
         "ES2024"
      ],
      "target": "es2024",
      "module": "node20",
      "moduleResolution": "node16",
      "rootDir": "./src",
      "esModuleInterop": true,
      "outDir": "./build",
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "sourceMap": true,
      "strictPropertyInitialization": false,
      "resolveJsonModule": true,
   },
   "include": ["src/**/*"],
   "exclude": ["node_modules"]
}